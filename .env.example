# ==============================================================================
# PattuBook Back Office Assistant - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In Railway: If you attach a PostgreSQL database, Railway automatically sets DATABASE_URL.
# If omitted, the system falls back to local SQLite (data/backoffice.db).
# Example Railway PostgreSQL: postgresql://postgres:password@junction.proxy.rlwy.net:12345/railway
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens.
# In Railway: Generate a strong 32+ character random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=production_secret_key_change_me_to_a_random_32_char_hex_string

# Environment Mode: Set to 'production' on Railway
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 3. SERVER NETWORKING
# ------------------------------------------------------------------------------
# In Railway: Railway automatically injects the PORT variable.
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 4. BUSINESS & STORE PROFILE DEFAULTS
# ------------------------------------------------------------------------------
BUSINESS_NAME=Enterprise Retail Store
OWNER_NAME=Proprietor
BUSINESS_GSTIN=27AAPCG1234F1Z8
BUSINESS_PHONE=+91 98200 12345
BUSINESS_EMAIL=store@example.com
BUSINESS_UPI_ID=store@upi
BUSINESS_CA_EMAIL=ca@example.com
CURRENCY_SYMBOL=₹

# ------------------------------------------------------------------------------
# 5. AUTOMATED IMAP INBOUND EMAIL INGESTION (Optional)
# ------------------------------------------------------------------------------
# Automatically polls every 5 minutes in background and categorizes bills, bank alerts, and GST notices.
# For Gmail: Use a 16-character App Password from Google Account Security -> App Passwords.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_16_char_google_app_password
IMAP_SYNC_INTERVAL_MINUTES=5
IMAP_FOLDER=INBOX

# ------------------------------------------------------------------------------
# 6. SMTP OUTBOUND EMAIL DISPATCH (Optional)
# ------------------------------------------------------------------------------
# If provided, account registration sends real verification emails to users.
# If empty, the system runs in instant preview mode where verification tokens are displayed directly in the UI.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=no-reply@pattubook.com

# ------------------------------------------------------------------------------
# 7. AI & HEURISTIC ENGINE SETTINGS (Optional)
# ------------------------------------------------------------------------------
# Built-in offline regex & heuristic parsing works 100% out-of-the-box with no external dependencies.
# If you have an external Ollama or LLM server, configure it below:
AI_PROVIDER=local
LOCAL_AI_MODEL=gemma2:2b
LOCAL_AI_ENDPOINT=http://localhost:11434
